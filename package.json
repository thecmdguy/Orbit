{
  "name": "orbit",
  "version": "1.0.0",
  "description": "Orbit — a self-hosted web client for Claude Code: chat with tool approvals, a live server monitor, a file editor, site backups, skills, and iOS push notifications.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/thecmdguy/Orbit#readme",
  "repository": { "type": "git", "url": "https://github.com/thecmdguy/Orbit.git" },
  "bugs": { "url": "https://github.com/thecmdguy/Orbit/issues" },
  "keywords": ["claude", "claude-code", "anthropic", "agent", "web-ui", "self-hosted", "chat"],
  "engines": { "node": ">=18.17" },
  "bin": { "orbit-setup": "bin/orbit-setup.mjs" },
  "scripts": {
    "setup": "node bin/orbit-setup.mjs",
    "start": "node bin/orbit-start.mjs",
    "start:server": "node server.mjs",
    "pm2": "pm2 start ecosystem.config.cjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.309",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "dompurify": "^3.1.6",
    "marked": "^12.0.2",
    "monaco-editor": "^0.52.2",
    "node-pty": "^1.0.0",
    "web-push": "^3.6.7",
    "ws": "^8.18.0"
  }
}
