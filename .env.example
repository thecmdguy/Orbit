# Orbit configuration. Copy to ".env" and edit. Every value has a sensible default,
# so for a quick local run you can leave this file empty (or absent) and just run setup.
# Anything set in the real environment overrides what's here.

# ---- Where the app lives ----
# URL path prefix the app is served under. The bundled frontend expects /claude.
ORBIT_BASE=/claude
# Loopback host the Node services bind to (nginx proxies to this).
ORBIT_HOST=127.0.0.1
# Public URL of your deployment (used to seed the Monitor's shortcut). Optional.
# e.g. https://orbit.example.com
ORBIT_PUBLIC_URL=

# ---- Ports (main server + five side services) ----
ORBIT_PORT=3020
ORBIT_USAGE_PORT=3021
ORBIT_MODELS_PORT=3022
ORBIT_SKILLS_PORT=3023
ORBIT_PUSH_PORT=3024
ORBIT_EXPLAIN_PORT=3025

# ---- Security ----
# Comma-separated browser origins allowed for POST/PUT and WebSockets.
# REQUIRED in production, e.g. https://orbit.example.com
# If left empty, only http(s)://localhost and 127.0.0.1 (any port) are allowed.
ORBIT_ORIGINS=

# ---- Claude Code ----
# Directory Claude works in (its cwd for every chat). Defaults to your home dir.
ORBIT_WORKDIR=
# Path to the Claude Code CLI. Defaults to ~/.local/bin/claude, else "claude" on PATH.
ORBIT_CLAUDE_BIN=
# The Claude CLI's own dir (credentials + session transcripts). Defaults to ~/.claude
ORBIT_CLAUDE_DIR=

# ---- Orbit's own data (kept out of the repo) ----
# Defaults to ~/.orbit . Holds config.json, password, quick.json, links.json,
# push.json, changes/, models-data/, uploads/, trash/, backups/.
ORBIT_DATA_DIR=
# Override individual locations if you want:
# ORBIT_UPLOADS_DIR=
# ORBIT_TRASH_DIR=
# ORBIT_BACKUP_DIR=

# ---- Web Push (optional) ----
# Contact email embedded in VAPID details.
ORBIT_PUSH_EMAIL=admin@example.com
